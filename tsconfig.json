{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "build",
    "newLine": "lf"
  },
  "include": ["vocabulary.ts", "book-catalog.ts", "speed-reader-core.ts", "src/**/*.ts"]
}
